# FitBook — configuration template
#
# This is the ONLY env file committed to the repository. It documents every key
# and carries placeholder values, never real secrets.
#
# Setup:
#   cp .env.example .env.dev     # used when ASPNETCORE_ENVIRONMENT=Development
#   cp .env.example .env.prod    # used when ASPNETCORE_ENVIRONMENT=Production
#
# Both .env.dev and .env.prod are gitignored. For submission the real values
# ship alongside the repo as a password-protected .env-tajne.zip, never in git.
#
# Key names use the Section__Key form so .NET's environment-variable provider
# maps them onto configuration paths automatically (__ becomes :), which also
# lets Docker Compose inject the same names later with no code change.

# --- Database -----------------------------------------------------------------
# Local SQL Server runs in Docker (container: fitbook-sqlserver, port 1433).
# Database name is the index number: 230209 for prod, 230209_dev for dev.
ConnectionStrings__Default=Server=localhost,1433;Database=230209_dev;User Id=sa;Password=<sa-password>;TrustServerCertificate=True

# --- JWT ----------------------------------------------------------------------
# Key must be at least 32 bytes. Generate with: openssl rand -base64 48
Jwt__Key=<base64-key-min-32-bytes>
Jwt__Issuer=FitBook.Api
Jwt__Audience=FitBook.Clients
Jwt__AccessTokenMinutes=60

# --- RabbitMQ -----------------------------------------------------------------
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__Username=<rabbit-user>
RabbitMq__Password=<rabbit-password>
RabbitMq__Sender=fitbook-api

# --- SMTP ---------------------------------------------------------------------
Smtp__Host=<smtp-host>
Smtp__Port=587
Smtp__Username=<smtp-user>
Smtp__Password=<smtp-password>
Smtp__UseSsl=true

# --- Stripe -------------------------------------------------------------------
# Sandbox secret key. Never a live key, never committed.
Stripe__SecretKey=<stripe-sandbox-secret-key>

# --- Frontend -----------------------------------------------------------------
# Not read by .NET. Records the value passed to Flutter as
# --dart-define=API_BASE_URL=... : localhost for Windows, 10.0.2.2 for Android.
ApiBaseUrl=http://localhost:5274
